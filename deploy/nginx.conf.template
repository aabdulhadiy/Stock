# Reverse proxy for the Warehouse & Sales app (§16.1).
#
# nginx:alpine renders this template with envsubst on start, so ${APP_DOMAIN}
# comes from the compose environment.
#
# Before a certificate exists, only the HTTP block below is usable — that is
# deliberate: it serves the ACME challenge so certbot can issue one. Once
# /etc/letsencrypt/live/${APP_DOMAIN} exists, uncomment the HTTPS server and
# the redirect, then `docker compose restart nginx`. The runbook walks through it.

server {
    listen 80;
    server_name ${APP_DOMAIN};

    # ACME HTTP-01 challenge. Must stay reachable over plain HTTP for renewals.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # --- Before HTTPS is set up: proxy directly. ---------------------------
    # After running the certificate step, comment this block out and uncomment
    # the redirect below, so §14's "HTTPS only" holds.
    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # location / {
    #     return 301 https://$host$request_uri;
    # }
}

