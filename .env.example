# ---------------------------------------------------------------------------
# Warehouse & Sales Management System — environment
#
# Copy to .env and fill in. Every variable the application or docker-compose
# reads is documented here (§16.3).
# ---------------------------------------------------------------------------

# === Required ==============================================================

# PostgreSQL. Under Docker, compose builds this from the POSTGRES_* values below
# and you can leave it as-is; set it directly when running outside Docker.
DATABASE_URL="postgresql://stock:stock@127.0.0.1:5432/stockdb"

# Secret used to sign session cookies. At least 32 characters — the app refuses
# to start with anything shorter. Generate one with:
#   openssl rand -base64 48
# Changing it signs everyone out, which is harmless.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"


# === Docker Compose ========================================================

# Credentials for the `db` service. The password has no default on purpose:
# compose fails to start rather than bringing up a database with a known one.
POSTGRES_USER="stock"
POSTGRES_PASSWORD=""
POSTGRES_DB="stockdb"

# The domain nginx serves and certbot issues a certificate for.
APP_DOMAIN="localhost"


# === Storage ===============================================================

# Where uploaded product images and expense receipts are written. Must be a
# persistent volume; under Docker this is set to /app/var/uploads for you.
UPLOAD_DIR="./var/uploads"


# === Backups (§14) =========================================================

# Retention in days. §14 requires at least 30.
BACKUP_RETENTION_DAYS="30"

# Hour of day (UTC) the daily backup runs.
BACKUP_HOUR="2"

# §14 requires backups to be copied OFF the application server. Point this at a
# second disk or a mounted remote share. The default is a local folder so a
# single-disk install still works — but a local folder is not off-server storage.
BACKUP_OFFSITE_DIR="./var/backups-offsite"


# === Tuning ================================================================

# Maximum PostgreSQL connections in the app's pool. 15 comfortably serves the
# 10 concurrent users §14 asks for on a 2 vCPU VPS.
DB_POOL_MAX="15"


# === One-off seed values ===================================================
# Used only by `npm run db:seed`, which is idempotent and safe to re-run.
# In production the seed refuses to create a Director unless the password is set
# here, so the system never comes up with a well-known default.

SEED_DIRECTOR_LOGIN="director"
SEED_DIRECTOR_PASSWORD=""
SEED_DIRECTOR_NAME="Director"
