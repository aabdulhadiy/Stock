# ---------------------------------------------------------------------------
# Warehouse & Sales Management System — environment
# Copy to .env and fill in. Every variable the app reads is listed here.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
DATABASE_URL="postgresql://stock:stock@127.0.0.1:5432/stockdb"

# Max PostgreSQL connections in the app's pool. 15 comfortably serves the
# 10 concurrent users required by §14 on a 2 vCPU VPS.
DB_POOL_MAX="15"

# Secret used to sign session JWTs (required, at least 32 characters).
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Where uploaded product images and expense receipts are written. Must be a
# persistent volume — see docker-compose.yml.
UPLOAD_DIR="./var/uploads"

# ---------------------------------------------------------------------------
# One-off seed values (used only by `npm run db:seed`)
# ---------------------------------------------------------------------------
SEED_DIRECTOR_LOGIN="director"
SEED_DIRECTOR_PASSWORD="director12345"
SEED_DIRECTOR_NAME="Director"
