# PostgreSQL connection string
DATABASE_URL="postgresql://stock:stock@127.0.0.1:5432/stockdb"

# Secret used to sign session JWTs (use a long random string in production)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Initial admin account created by the seed script
SEED_ADMIN_EMAIL="admin@toy.local"
SEED_ADMIN_PASSWORD="admin12345"

# Initial UZS-per-USD exchange rate used to seed the first rate row
SEED_EXCHANGE_RATE="12600"
